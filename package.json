{
  "name": "cftracker",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@popperjs/core": "^2.11.8",
    "@reduxjs/toolkit": "^2.12.0",
    "@types/redux-logger": "^3.0.13",
    "axios": "^1.7.2",
    "bootstrap": "^5.3.3",
    "chart.js": "^4.4.6",
    "chartjs-plugin-datalabels": "^2.2.0",
    "d3": "^7.9.0",
    "lodash": "^4.17.21",
    "react": "^19.2.7",
    "react-bootstrap": "^2.10.5",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.7",
    "react-ga4": "^3.0.1",
    "react-loader-spinner": "^8.0.2",
    "react-redux": "^9.3.0",
    "react-router": "^8.3.0",
    "react-toastify": "^11.1.0",
    "redux-logger": "^3.0.6",
    "redux-thunk": "^3.1.0",
    "sass": "^1.77.8",
    "store": "^2.0.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "node --experimental-strip-types node_modules/eslint/bin/eslint.js --flag unstable_native_nodejs_ts_config . --max-warnings 0",
    "typecheck": "tsc -b",
    "hooks:install": "node scripts/validation/install-hooks.mts",
    "prepare": "npm run hooks:install",
    "test:policy": "node --test scripts/validation/*.test.mts && node scripts/validation/check-repository-hygiene.mts --tracked",
    "lint:secrets": "secretlint --no-color \"**/*\"",
    "lint:secrets:ci": "secretlint --format github \"**/*\"",
    "verify:policy": "npm run test:policy && npm run lint:secrets",
    "verify:frontend": "npm run typecheck && npm run lint && npm run build",
    "verify:ci": "npm run verify:policy && npm run verify:frontend",
    "verify:backend": "make -C backend test",
    "verify": "npm run verify:ci && npm run verify:backend"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "@types/node": "^22.18.0",
    "@types/d3": "^7.4.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "secretlint": "^13.0.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4"
  }
}
