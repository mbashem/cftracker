GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret
DATABASE_URL=postgres://postgres:postgrespw@localhost:5432/cftracker?sslmode=disable
JWT_SECRET=
JWT_TTL=168h
# Optional rotation settings; see README.md before enabling:
# JWT_ACTIVE_KEY_IDS='["rotation-2"]'
# JWT_KEYS='{"default":"REPLACE_WITH_EXISTING_SECRET","rotation-2":"REPLACE_WITH_NEW_RANDOM_SECRET"}'
CORS_ALLOWED_ORIGINS=http://localhost:5173
PORT=8080
EXTERNAL_API_TIMEOUT=10s
DATABASE_TIMEOUT=5s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=30s
